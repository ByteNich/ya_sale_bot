# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321  # Comma-separated list of admin Telegram IDs

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ya_sale_bot

# Parser Configuration
CHECK_INTERVAL=120  # Check prices every 120 seconds (2 minutes)
DISCOUNT_THRESHOLD=10  # Minimum discount percentage to notify (10%)

# Yandex Market Configuration
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
